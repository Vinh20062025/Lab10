<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Danh sách bài viết</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1>Danh sách bài viết</h1>
    <nav>
        <a href="/">Trang chủ</a>
        <a href="/news">Tin tức</a>
        <% if (user) { %>
            <span>Xin chào, <%= user.username %></span>
            <a href="/logout">Đăng xuất</a>
        <% } else { %>
            <a href="/login">Đăng nhập</a>
        <% } %>
    </nav>

    <% if (user) { %>
        <p><a href="/news/add">Thêm bài viết</a></p>
    <% } %>

    <ul>
        <% posts.forEach(post => { %>
            <li>
                <h3>
                    <a href="/news/<%= post.id %>"><%= post.title %></a>
                </h3>
                <% if (user) { %>
                    <a href="/news/<%= post.id %>/edit">Sửa</a>
                    <form action="/news/<%= post.id %>/delete" method="POST" style="display:inline;">
                        <button type="submit">Xóa</button>
                    </form>
                <% } %>
            </li>
        <% }) %>
    </ul>
</body>
</html>